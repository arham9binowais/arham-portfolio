# Copy this file to .env for local development.
# On Vercel, set these same keys under Project Settings > Environment Variables.

# Local server port (ignored on Vercel)
PORT=3000

# Admin login credentials (required on Vercel - admin login is disabled if ADMIN_PASSWORD is empty)
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=change-me

# MongoDB Atlas "Drivers" connection string (Node.js). Required.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio
MONGODB_COLLECTION=portfolios
MONGODB_SESSIONS_COLLECTION=sessiondb

# Optional: custom DNS resolvers for the mongodb+srv lookup (local networks that block SRV)
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Optional: email notifications via Gmail App Password
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=
NOTIFY_FROM_EMAIL=yourname@gmail.com
# Inbox that receives the alerts (visits, edits, logouts)
NOTIFY_TO_EMAIL=yourname@gmail.com
# Send batched edit emails after this many ms (default 300000 = 5 min)
# PENDING_EDIT_DELAY_MS=60000
TIMEZONE=Asia/Karachi
